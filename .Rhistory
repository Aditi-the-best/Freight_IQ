PDF_Uniform<- function(x){
ifelse (x>=0& x<=1,1,0)
}
expected_value<- integrate (function(x) x*PDF_Uniform(x),0,1)$value
cat("The expected value E(X):", expected_value, "\n")
ev_squared= integrate( function(x) (x^2) *PDF_Uniform(x),0,1)$value
Variance<- ev_squared- ((expected_value)^2)
cat("The Variance Var(x):", variance, "\n")
x <- c(1, 2, 3)
p <- c(0.2, 0.5, 0.3)
mean_x <- sum(x * p)
var_x <- sum((x - mean_x)^2 * p)
sd_x <- sqrt(var_x)
cat("Mean:", mean_x, "\n")
cat("Variance:", var_x, "\n")
cat("Standard Deviation:", sd_x, "\n")
f <- function(x) {
ifelse(x >= 0 & x <= 1, 2 * x,
ifelse(x > 1 & x <= 2, 2 * (2 - x), 0))
}
exp_fn <- function(x) { x * f(x) }
ev <- integrate(exp_fn, lower = 0, upper = 2)$value
var_fn <- function(x) { (x - ev)^2 * f(x) }
variance <- integrate(var_fn, lower = 0, upper = 2)$value
cat("Expected Value:", ev, "\n")
cat("Variance:", variance, "\n")
dbinom(3,size=10,prob=1/5)
probabilities=dbinom(x=c(0:10),size=10,prob=1/5)
df=data.frame(probabilities)
df
plot(probabilities,type="b",main="Probabilities",xlab="x",ylab="Probabilities",col="red")
barplot(probabilities,main="Probabilities",xlim=c(0,11),ylim=c(0,1),col=yellow)
